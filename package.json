{
  "name": "fern-dashboard",
  "version": "1.2.0",
  "description": "Fern Telemetry desktop dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.fern.dashboard",
    "productName": "Fern Dashboard",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "FernDashboard-Setup-${version}.${ext}"
    }
  }
}
